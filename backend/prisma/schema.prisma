datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
  loginAttempts LoginAttempt[]
}

model UserSession {
  id           String   @id
  userId       String
  refreshToken String
  expiresAt    DateTime
  status       String   // ACTIVE, REVOKED, EXPIRED
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id         String   @id @default(uuid())
  userId     String
  timestamp  DateTime
  ipAddress  String
  successful Boolean
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id
  slug      String   @unique
  name      String
  currency  String
  ownerId   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   BusinessProfile?

  @@index([ownerId])
}

model BusinessProfile {
  organizationId String   @id
  businessType   String
  country        String
  contactInfo    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Customer {
  id             String   @id
  organizationId String
  customerNumber String
  name           String
  primaryContact String
  billingAddress String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Invoice {
  id            String            @id
  invoiceNumber String            @unique
  customerId    String
  organizationId String           @default("default-org-id")
  status        String            // DRAFT, ISSUED, SENT, PAID, OVERDUE, CANCELLED
  totalAmount   Decimal @db.Decimal(18, 4)
  currency      String
  issuedAt      DateTime?
  dueDate       DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lineItems     InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id
  invoiceId   String
  description String
  quantity    Int
  price       Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 4)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String   @id
  organizationId   String
  invoiceId        String
  reference        String
  amount           Decimal @db.Decimal(18, 4)
  currency         String
  status           String
  gatewayReference String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  statusCode   Int
  responseBody String
  createdAt    DateTime @default(now())
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String?   @unique
  eventType   String
  aggregateId String?
  payload     String
  processed   Boolean   @default(false)
  retryCount  Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model ReceivableAccount {
  id               String   @id
  organizationId   String
  customerId       String
  status           String
  collectionStatus String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  entries             ReceivableEntry[]
  credits             ReceivableCredit[]
  paymentApplications ReceivablePaymentApplication[]
  collectionActions   ReceivableCollectionAction[]

  @@unique([organizationId, customerId])
}

model ReceivableEntry {
  id              String   @id
  accountId       String
  invoiceId       String
  originalAmount  Decimal  @db.Decimal(18, 4)
  remainingAmount Decimal  @db.Decimal(18, 4)
  currency        String
  dueDate         DateTime
  account         ReceivableAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, invoiceId])
  @@index([invoiceId])
}

model ReceivableCredit {
  id              String   @id
  accountId       String
  source          String
  amount          Decimal  @db.Decimal(18, 4)
  remainingAmount Decimal  @db.Decimal(18, 4)
  currency        String
  reason          String
  createdAt       DateTime
  account         ReceivableAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ReceivablePaymentApplication {
  id           String   @id
  accountId    String
  settlementId String
  invoiceId    String
  amount       Decimal  @db.Decimal(18, 4)
  currency     String
  appliedAt    DateTime
  account      ReceivableAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ReceivableCollectionAction {
  id          String   @id
  accountId   String
  actionType  String
  notes       String
  performedBy String
  timestamp   DateTime
  account     ReceivableAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
