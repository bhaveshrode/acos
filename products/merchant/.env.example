# ACOS Merchant V1 — Configuration Environment Variables
# Copy this file to .env and customize values for your deployment context

# -----------------------------------------------------------------------------
# Runtime Environment Settings
# -----------------------------------------------------------------------------
# Merchant execution port binding (Default: 8080)
MERCHANT_PORT=8080

# Environment lifecycle mode: development, staging, production, test
MERCHANT_ENV=development

# -----------------------------------------------------------------------------
# Database Persistence Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Prisma connection URL to external PostgreSQL database instance
MERCHANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merchant_dev?schema=public"

# -----------------------------------------------------------------------------
# ACOS OS Connectivity
# -----------------------------------------------------------------------------
# Base URL endpoint of the core ACOS OS kernel service
ACOS_ENDPOINT="http://localhost:3000"

# Enable ACOS runtime subsystems integration boundary (true/false)
ENABLE_ACOS_FEATURES=true

# -----------------------------------------------------------------------------
# Security & Cryptography Credentials
# -----------------------------------------------------------------------------
# Shared cryptographic signing secret for incoming Stripe webhook verification
STRIPE_WEBHOOK_SECRET="whsec_stripe_test_secret_123456789"

# Asymmetric JSON Web Token secret key for session credentials generation
JWT_SECRET="acos-secret-key-123456789-super-long-required-signing-key"
